---
const siteName = "Harikrishnan Varma";
const email = "hari@harikrishnanvarma.com"; // Replace with your actual email
const instagramUrl = "https://instagram.com/d00kl1"; // Replace with your Instagram URL
const buildYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-container">
    <!-- Icon-only Links -->
    <div class="footer-links">
      <a href={`mailto:${email}`} class="footer-link" aria-label="Send Email">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </a>

      <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="footer-link" aria-label="Instagram Profile">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
      </a>
    </div>

    <!-- Copyright Text -->
    <p class="copyright">
      &copy; <span id="footer-year">{buildYear}</span> {siteName}. All rights reserved.
    </p>
  </div>
</footer>

<script>
  function updateYear() {
    const yearSpan = document.getElementById('footer-year');
    if (yearSpan) {
      yearSpan.textContent = new Date().getFullYear().toString();
    }
  }
  updateYear();
  document.addEventListener('astro:page-load', updateYear);
</script>

<style>
  .site-footer {
    background-color: #1a1a1a;
    color: #a0a0a0;
    width: 100%;
    margin-top: auto;
    border-top: 1px solid #2a2a2a;
    font-size: 0.875rem;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .footer-link {
    color: #a0a0a0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    border-radius: 50%;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .footer-link:hover {
    color: #ffffff;
    background-color: #2a2a2a;
  }

  .copyright {
    margin: 0;
    letter-spacing: 0.02em;
    font-size: 0.8125rem;
    opacity: 0.75;
  }

  @media (min-width: 768px) {
    .footer-container {
      padding: 2.5rem 2rem;
    }
  }
</style>