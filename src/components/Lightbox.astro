---
/* Lightbox.astro - Global accessible modal lightbox */
---

<dialog id="global-lightbox" class="lightbox-dialog" aria-label="Media viewer">
  <div class="lightbox-content">
    <button id="lightbox-close" class="nav-btn close-btn" aria-label="Close lightbox">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>

    <button id="lightbox-prev" class="nav-btn prev-btn" aria-label="Previous artwork">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>

    <div class="lightbox-stage">
      <img id="lightbox-img" src="" alt="" />
      <div id="lightbox-caption" class="lightbox-caption">
        <h3 id="lightbox-title"></h3>
        <p id="lightbox-meta"></p>
      </div>
    </div>

    <button id="lightbox-next" class="nav-btn next-btn" aria-label="Next artwork">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
  </div>
</dialog>

<style>
  .lightbox-dialog {
    margin: auto;
    padding: 0;
    border: none;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    color: #ffffff;
    overflow: hidden;
  }

  .lightbox-dialog::backdrop {
    background: rgba(10, 10, 10, 0.92);
    backdrop-filter: blur(8px);
  }

  .lightbox-content {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    box-sizing: border-box;
  }

  .lightbox-stage {
    position: relative;
    max-width: calc(100vw - 3rem);
    max-height: calc(100vh - 5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .lightbox-stage img {
    max-width: 100%;
    max-height: calc(100vh - 7rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 2px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
    user-select: none;
    -webkit-user-drag: none;
  }

  .lightbox-caption {
    margin-top: 0.875rem;
    text-align: center;
  }

  .lightbox-caption h3 {
    font-size: 0.9375rem;
    font-weight: 400;
    margin: 0;
    color: #ffffff;
    letter-spacing: 0.01em;
  }

  .lightbox-caption p {
    font-size: 0.8125rem;
    color: #a0a0a0;
    margin: 0.25rem 0 0 0;
  }

  .nav-btn {
    position: absolute;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #ffffff;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    z-index: 10;
  }

  .nav-btn:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .close-btn {
    top: 1.5rem;
    right: 1.5rem;
  }

  .prev-btn {
    left: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .next-btn {
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
  }

  @media (max-width: 768px) {
    .lightbox-content {
      padding: 1rem;
    }

    .lightbox-stage {
      max-width: 100vw;
      max-height: calc(100vh - 4rem);
    }

    .lightbox-stage img {
      max-height: calc(100vh - 8rem);
    }

    .prev-btn {
      left: 0.5rem;
    }

    .next-btn {
      right: 0.5rem;
    }

    .close-btn {
      top: 0.75rem;
      right: 0.75rem;
    }
  }
</style>

<script>
  function setupGlobalLightbox() {
    const dialog = document.getElementById('global-lightbox') as HTMLDialogElement | null;
    const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const titleEl = document.getElementById('lightbox-title');
    const metaEl = document.getElementById('lightbox-meta');
    const captionBox = document.getElementById('lightbox-caption');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');

    if (!dialog || !img) return;

    let items: HTMLElement[] = [];
    let currentIndex = 0;
    let touchStartX = 0;
    let touchStartY = 0;

    const renderActiveImage = () => {
      const activeTrigger = items[currentIndex];
      if (!activeTrigger) return;

      const src = activeTrigger.getAttribute('data-lightbox-src') || '';
      const alt = activeTrigger.getAttribute('data-lightbox-alt') || '';
      const title = activeTrigger.getAttribute('data-lightbox-title') || '';
      const meta = activeTrigger.getAttribute('data-lightbox-meta') || '';

      img.src = src;
      img.alt = alt;

      if (titleEl) titleEl.textContent = title;
      if (metaEl) metaEl.textContent = meta;

      if (captionBox) {
        captionBox.style.display = (title || meta) ? 'block' : 'none';
      }
    };

    const showPrev = () => {
      if (items.length <= 1) return;
      currentIndex = (currentIndex - 1 + items.length) % items.length;
      renderActiveImage();
    };

    const showNext = () => {
      if (items.length <= 1) return;
      currentIndex = (currentIndex + 1) % items.length;
      renderActiveImage();
    };

    const closeModal = () => {
      if (dialog && dialog.open) {
        dialog.close();
        document.body.style.overflow = '';
      }
    };

    // Attach explicit addEventListener rather than property assignments
    prevBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      showPrev();
    });

    nextBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      showNext();
    });

    closeBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      closeModal();
    });

    // Global click listener for triggers
    const handleTriggerClick = (e: MouseEvent) => {
      const target = e.target as HTMLElement;
      const trigger = target.closest('[data-lightbox-src]') as HTMLElement;

      if (!trigger) return;

      items = Array.from(document.querySelectorAll('[data-lightbox-src]'));
      currentIndex = items.indexOf(trigger);

      if (currentIndex !== -1) {
        renderActiveImage();

        if (prevBtn && nextBtn) {
          const hasMultiple = items.length > 1;
          prevBtn.style.display = hasMultiple ? 'flex' : 'none';
          nextBtn.style.display = hasMultiple ? 'flex' : 'none';
        }

        dialog.showModal();
        document.body.style.overflow = 'hidden';
      }
    };

    document.removeEventListener('click', handleTriggerClick);
    document.addEventListener('click', handleTriggerClick);

    // Keyboard Navigation
    const handleKeyDown = (e: KeyboardEvent) => {
      if (!dialog.open) return;
      if (e.key === 'ArrowLeft') showPrev();
      if (e.key === 'ArrowRight') showNext();
      if (e.key === 'Escape') closeModal();
    };

    document.removeEventListener('keydown', handleKeyDown);
    document.addEventListener('keydown', handleKeyDown);

    // Touch Support
    dialog.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].screenX;
      touchStartY = e.changedTouches[0].screenY;
    }, { passive: true });

    dialog.addEventListener('touchend', (e: TouchEvent) => {
      if (!dialog.open || items.length <= 1) return;

      const deltaX = e.changedTouches[0].screenX - touchStartX;
      const deltaY = e.changedTouches[0].screenY - touchStartY;

      if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) >= 40) {
        if (deltaX < 0) showNext();
        else showPrev();
      }
    }, { passive: true });

    // Backdrop Click Close
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) closeModal();
    });

    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
    });
  }

  document.addEventListener('DOMContentLoaded', setupGlobalLightbox);
  document.addEventListener('astro:page-load', setupGlobalLightbox);
</script>