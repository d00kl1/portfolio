---
/* Lightbox.astro - Deep Zoom Viewer with Bottom Magnification Control */
---

<dialog id="global-lightbox" class="lightbox-dialog" aria-label="Media viewer">
  <div class="lightbox-content">
    <!-- Top Close Button -->
    <button id="lightbox-close" class="nav-btn close-btn" aria-label="Close lightbox" type="button">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>

    <!-- Navigation Buttons -->
    <button id="lightbox-prev" class="nav-btn prev-btn" aria-label="Previous artwork" type="button">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>

    <div class="lightbox-stage">
      <!-- OpenSeadragon Mount Target -->
      <div id="openseadragon-viewer" class="osd-container"></div>
      
      <!-- Bottom Control Bar & Caption -->
      <div class="lightbox-bottom-bar">
        <div id="lightbox-caption" class="lightbox-caption">
          <h3 id="lightbox-title"></h3>
          <p id="lightbox-meta"></p>
        </div>

        <div class="zoom-controls">
          <button id="zoom-out" class="control-btn" aria-label="Zoom out" type="button">−</button>
          <input 
            type="range" 
            id="zoom-slider" 
            min="1" 
            max="5" 
            step="0.01" 
            value="1" 
            aria-label="Magnification slider" 
          />
          <button id="zoom-in" class="control-btn" aria-label="Zoom in" type="button">+</button>
          <button id="zoom-reset" class="control-btn reset-btn" aria-label="Reset zoom" type="button">Reset</button>
        </div>
      </div>
    </div>

    <button id="lightbox-next" class="nav-btn next-btn" aria-label="Next artwork" type="button">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
  </div>
</dialog>

<!-- OpenSeadragon Engine via CDN -->
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/openseadragon/4.1.0/openseadragon.min.js"></script>

<style>
  .lightbox-dialog {
    margin: auto;
    padding: 0;
    border: none;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    color: #ffffff;
    overflow: hidden;
  }

  .lightbox-dialog::backdrop {
    background: rgba(10, 10, 10, 0.94);
    backdrop-filter: blur(12px);
  }

  .lightbox-content {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    box-sizing: border-box;
  }

  .lightbox-stage {
    position: relative;
    width: 100%;
    height: calc(100vh - 4rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .osd-container {
    width: 100%;
    height: 100%;
    background: transparent;
  }

  /* Bottom Bar Overlay */
  .lightbox-bottom-bar {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    z-index: 20;
    pointer-events: none;
    width: max-content;
    max-width: calc(100vw - 3rem);
  }

  .lightbox-bottom-bar * {
    pointer-events: auto;
  }

  .lightbox-caption {
    text-align: center;
    background: rgba(18, 18, 18, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 0.5rem 1.25rem;
    border-radius: 20px;
    backdrop-filter: blur(8px);
  }

  .lightbox-caption h3 {
    font-size: 0.9375rem;
    font-weight: 400;
    margin: 0;
    color: #ffffff;
  }

  .lightbox-caption p {
    font-size: 0.8125rem;
    color: #a0a0a0;
    margin: 0.2rem 0 0 0;
  }

  /* Zoom Controls Container */
  .zoom-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(18, 18, 18, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.35rem 0.875rem;
    border-radius: 30px;
    backdrop-filter: blur(8px);
  }

  .control-btn {
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 1.125rem;
    cursor: pointer;
    width: 1.75rem;
    height: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background-color 0.2s ease;
  }

  .control-btn:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .reset-btn {
    font-size: 0.75rem;
    width: auto;
    padding: 0 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #a0a0a0;
  }

  .reset-btn:hover {
    color: #ffffff;
  }

  #zoom-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 120px;
    height: 3px;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 2px;
    outline: none;
  }

  #zoom-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ffffff;
    cursor: pointer;
  }

  #zoom-slider::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ffffff;
    cursor: pointer;
    border: none;
  }

  .nav-btn {
    position: absolute;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
    z-index: 10;
  }

  .nav-btn:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .close-btn {
    top: 1.5rem;
    right: 1.5rem;
    z-index: 30;
  }

  .prev-btn {
    left: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .next-btn {
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
  }

  @media (max-width: 640px) {
    #zoom-slider {
      width: 70px;
    }
    .lightbox-bottom-bar {
      bottom: 0.75rem;
      gap: 0.5rem;
    }
    .prev-btn { left: 0.5rem; }
    .next-btn { right: 0.5rem; }
    .close-btn {
      top: 0.75rem;
      right: 0.75rem;
    }
  }
</style>

<script>
  declare const OpenSeadragon: any;

  function setupGlobalLightbox() {
    const dialog = document.getElementById('global-lightbox') as HTMLDialogElement | null;
    const titleEl = document.getElementById('lightbox-title');
    const metaEl = document.getElementById('lightbox-meta');
    const captionBox = document.getElementById('lightbox-caption');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');

    const zoomSlider = document.getElementById('zoom-slider') as HTMLInputElement | null;
    const zoomInBtn = document.getElementById('zoom-in');
    const zoomOutBtn = document.getElementById('zoom-out');
    const zoomResetBtn = document.getElementById('zoom-reset');

    if (!dialog) return;

    let viewer: any = null;
    let items: HTMLElement[] = [];
    let currentIndex = 0;

    const initViewer = () => {
      if (viewer) {
        viewer.destroy();
        viewer = null;
      }

      viewer = OpenSeadragon({
        id: 'openseadragon-viewer',
        prefixUrl: 'https://cdnjs.cloudflare.com/ajax/libs/openseadragon/4.1.0/images/',
        showNavigationControl: false,
        gestureSettingsMouse: { clickToZoom: true },
        animationTime: 0.4,
        blendTime: 0.1,
        maxZoomPixelRatio: 4,
        visibilityRatio: 0.85,
        constrainDuringPan: true
      });

      viewer.addHandler('zoom', () => {
        if (!viewer || !zoomSlider) return;
        const currentZoom = viewer.viewport.getZoom();
        const minZoom = viewer.viewport.getMinZoom();
        const maxZoom = viewer.viewport.getMaxZoom();

        zoomSlider.min = minZoom.toString();
        zoomSlider.max = maxZoom.toString();
        zoomSlider.value = currentZoom.toString();
      });
    };

    const renderActiveImage = () => {
      const activeTrigger = items[currentIndex];
      if (!activeTrigger) return;

      const src = activeTrigger.getAttribute('data-lightbox-src') || '';
      const title = activeTrigger.getAttribute('data-lightbox-title') || '';
      const meta = activeTrigger.getAttribute('data-lightbox-meta') || '';

      if (titleEl) titleEl.textContent = title;
      if (metaEl) metaEl.textContent = meta;

      if (captionBox) {
        captionBox.style.display = (title || meta) ? 'block' : 'none';
      }

      if (!viewer) initViewer();

      viewer.open({
        type: 'image',
        url: src
      });
    };

    const showPrev = () => {
      if (items.length <= 1) return;
      currentIndex = (currentIndex - 1 + items.length) % items.length;
      renderActiveImage();
    };

    const showNext = () => {
      if (items.length <= 1) return;
      currentIndex = (currentIndex + 1) % items.length;
      renderActiveImage();
    };

    const closeModal = () => {
      if (dialog && dialog.open) {
        dialog.close();
        document.body.style.overflow = '';
      }
    };

    zoomSlider?.addEventListener('input', (e) => {
      if (!viewer) return;
      const targetVal = parseFloat((e.target as HTMLInputElement).value);
      viewer.viewport.zoomTo(targetVal);
    });

    zoomInBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      if (viewer) viewer.viewport.zoomBy(1.25);
    });

    zoomOutBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      if (viewer) viewer.viewport.zoomBy(0.8);
    });

    zoomResetBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      if (viewer) viewer.viewport.goHome();
    });

    prevBtn?.addEventListener('click', (e) => { e.preventDefault(); showPrev(); });
    nextBtn?.addEventListener('click', (e) => { e.preventDefault(); showNext(); });
    closeBtn?.addEventListener('click', (e) => { e.preventDefault(); closeModal(); });

    const handleTriggerClick = (e: MouseEvent) => {
      const target = e.target as HTMLElement;
      const trigger = target.closest('[data-lightbox-src]') as HTMLElement;

      if (!trigger) return;

      items = Array.from(document.querySelectorAll('[data-lightbox-src]'));
      currentIndex = items.indexOf(trigger);

      if (currentIndex !== -1) {
        dialog.showModal();
        document.body.style.overflow = 'hidden';
        renderActiveImage();

        if (prevBtn && nextBtn) {
          const hasMultiple = items.length > 1;
          prevBtn.style.display = hasMultiple ? 'flex' : 'none';
          nextBtn.style.display = hasMultiple ? 'flex' : 'none';
        }
      }
    };

    document.removeEventListener('click', handleTriggerClick);
    document.addEventListener('click', handleTriggerClick);

    const handleKeyDown = (e: KeyboardEvent) => {
      if (!dialog.open) return;
      if (e.key === 'ArrowLeft') showPrev();
      if (e.key === 'ArrowRight') showNext();
      if (e.key === 'Escape') closeModal();
    };

    document.removeEventListener('keydown', handleKeyDown);
    document.addEventListener('keydown', handleKeyDown);

    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
    });
  }

  document.addEventListener('DOMContentLoaded', setupGlobalLightbox);
  document.addEventListener('astro:page-load', setupGlobalLightbox);
</script>