---
interface Props {
  title: string;  
  pages: string[];
}

const { title, pages } = Astro.props;
---

<div 
  id="manga-reader" 
  class="relative w-full h-full flex-1 flex flex-col min-h-0 bg-neutral-950 text-white select-none overflow-hidden"
>
  
  <!-- Viewport Stage -->
  <main id="reader-stage" class="relative flex-1 w-full min-h-0 z-0 w-full h-full flex items-center justify-center p-3 md:p-8 cursor-pointer overflow-hidden">
    <!-- Dynamic Container (Rendered Inline to Prevent Scope Collisions) -->
    <div id="page-container"></div>    
  </main>  
</div>

<style>
  #reader-stage {
    touch-action: manipulation;
  }
</style>

<script is:inline define:vars={{ pages }}>
  let currentPage = 0;
  let isMobile = window.innerWidth < 768;
  let isDoubleSpread = !isMobile; 
  let isRTL = true;
  let controlsVisible = true;

  const container = document.getElementById('page-container');
  const pageIndicator = document.getElementById('page-indicator');
  const pageSlider = document.getElementById('page-slider');
  const header = document.getElementById('reader-header');
  const footer = document.getElementById('reader-footer');
  const spreadLabel = document.getElementById('spread-label');
  const dirLabel = document.getElementById('dir-label');
  const stage = document.getElementById('reader-stage');

  function preloadImages(indices) {
    indices.forEach(idx => {
      if (idx >= 0 && idx < pages.length) {
        const img = new Image();
        img.src = pages[idx];
      }
    });
  }

  function getActiveIndices() {
    if (!isDoubleSpread || isMobile || currentPage === 0) {
      return [currentPage];
    }
    
    const firstInSpread = currentPage % 2 === 0 ? currentPage - 1 : currentPage;
    const secondInSpread = firstInSpread + 1;

    if (secondInSpread < pages.length) {
      return [firstInSpread, secondInSpread];
    }
    return [firstInSpread];
  }

  function renderPages() {
    container.innerHTML = '';
    const indices = getActiveIndices();
    let pagesToDisplay = [...indices];

    if (isRTL && pagesToDisplay.length > 1) {
      pagesToDisplay.reverse();
    }

    // Direct inline styles bypass Astro CSS-scoping conflicts and prevent layout breakage
    container.style.display = 'flex';
    container.style.flexDirection = 'row';
    container.style.flexWrap = 'nowrap';
    container.style.alignItems = 'center';
    container.style.justifyContent = 'center';
    container.style.width = '100%';
    container.style.height = '100%';
    container.style.maxWidth = '100%';
    container.style.maxHeight = '100%';
    container.style.overflow = 'hidden';

    pagesToDisplay.forEach((idx) => {
      const wrapper = document.createElement('div');
      
      wrapper.style.display = 'flex';
      wrapper.style.alignItems = 'center';
      wrapper.style.justifyContent = 'center';
      wrapper.style.height = '100%';
      wrapper.style.maxHeight = '100%';
      wrapper.style.overflow = 'hidden';

      if (pagesToDisplay.length > 1) {
        wrapper.style.width = '50%';
        wrapper.style.flex = '0 0 50%';
      } else {
        wrapper.style.width = '100%';
        wrapper.style.flex = '0 0 100%';
      }

      const img = document.createElement('img');
      img.src = pages[idx];
      img.alt = `Page ${idx + 1}`;
      
      img.style.maxWidth = '100%';
      img.style.maxHeight = '100%';
      img.style.objectFit = 'contain';
      img.style.userSelect = 'none';
      img.style.display = 'block';
      
      wrapper.appendChild(img);
      container.appendChild(wrapper);
    });

    pageSlider.value = currentPage;

    if (indices.length > 1) {
      pageIndicator.innerText = `${indices[0] + 1}-${indices[1] + 1} / ${pages.length}`;
    } else {
      pageIndicator.innerText = `${currentPage + 1} / ${pages.length}`;
    }

    const nextIdx = indices[indices.length - 1] + 1;
    preloadImages([nextIdx, nextIdx + 1]);
  }

  function nextPage() {
    const indices = getActiveIndices();
    const nextStep = indices[indices.length - 1] + 1;
    if (nextStep < pages.length) {
      currentPage = nextStep;
      renderPages();
    }
  }

  function prevPage() {
    const indices = getActiveIndices();
    const prevStep = indices[0] - 1;
    if (prevStep >= 0) {
      currentPage = (isDoubleSpread && !isMobile && prevStep > 0 && prevStep % 2 === 0) 
        ? prevStep - 1 
        : prevStep;
      renderPages();
    }
  }

  // Touch Gestures
  let touchStartX = 0;
  let touchStartY = 0;

  stage.addEventListener('touchstart', (e) => {
    touchStartX = e.changedTouches[0].screenX;
    touchStartY = e.changedTouches[0].screenY;
  }, { passive: true });

  stage.addEventListener('touchend', (e) => {
    const touchEndX = e.changedTouches[0].screenX;
    const touchEndY = e.changedTouches[0].screenY;
    
    const diffX = touchEndX - touchStartX;
    const diffY = touchEndY - touchStartY;

    if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY)) {
      if (diffX < 0) {
        isRTL ? prevPage() : nextPage();
      } else {
        isRTL ? nextPage() : prevPage();
      }
    } else if (Math.abs(diffX) < 10 && Math.abs(diffY) < 10) {
      toggleControls();
    }
  }, { passive: true });  

  // Keyboard Navigation
  window.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' || e.key === 'd') {
      isRTL ? prevPage() : nextPage();
    } else if (e.key === 'ArrowLeft' || e.key === 'a') {
      isRTL ? nextPage() : prevPage();
    } else if (e.key === 'f') {
      toggleFullscreen();
    } else if (e.key === ' ') {
      toggleControls();
    }
  });

  pageSlider.addEventListener('input', (e) => {
    currentPage = parseInt(e.target.value, 10);
    renderPages();
  });

  const spreadBtn = document.getElementById('toggle-spread');
  if (spreadBtn) {
    spreadBtn.addEventListener('click', () => {
      isDoubleSpread = !isDoubleSpread;
      spreadLabel.innerText = isDoubleSpread ? '2-Page Spread' : 'Single Page';
      renderPages();
    });
  }

  document.getElementById('toggle-dir').addEventListener('click', () => {
    isRTL = !isRTL;
    dirLabel.innerText = isRTL ? 'RTL' : 'LTR';
    renderPages();
  });

  function toggleControls() {
    controlsVisible = !controlsVisible;
    header.style.opacity = controlsVisible ? '1' : '0';
    header.style.pointerEvents = controlsVisible ? 'auto' : 'none';
    footer.style.opacity = controlsVisible ? '1' : '0';
    footer.style.pointerEvents = controlsVisible ? 'auto' : 'none';
  }

  function toggleFullscreen() {
    if (!document.fullscreenElement) {
      document.documentElement.requestFullscreen().catch(() => {});
    } else {
      document.exitFullscreen().catch(() => {});
    }
  }

  const fsBtn = document.getElementById('toggle-fullscreen');
  if (fsBtn) fsBtn.addEventListener('click', toggleFullscreen);

  window.addEventListener('resize', () => {
    isMobile = window.innerWidth < 768;
    if (isMobile) {
      isDoubleSpread = false;
    }
    renderPages();
  });

  renderPages();
</script>