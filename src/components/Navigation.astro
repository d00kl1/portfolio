---
const navItems = [
  { name: "Paintings", href: "/paintings" },
  { name: "Drawings", href: "/drawings" },
  { name: "Manga", href: "/manga" },
  { name: "About", href: "/about" },
  { name: "Contact", href: "/contact" },
];
---

<header class="navbar">
  <div class="nav-container">
    <a href="/" class="logo">Harikrishnan Varma</a>

    <!-- Hamburger Toggle Button -->
    <button 
      id="menu-toggle" 
      aria-label="Toggle Navigation" 
      aria-controls="nav-menu"
      aria-expanded="false"
      type="button"
    >
      <span class="hamburger"></span>
    </button>

    <!-- Navigation Links -->
    <nav id="nav-menu" class="nav-links">
      <ul>
        {navItems.map((item) => (
          <li><a href={item.href} class="nav-item">{item.name}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  function initNavigation() {
    const toggleBtn = document.getElementById('menu-toggle');
    const navMenu = document.getElementById('nav-menu');

    if (!toggleBtn || !navMenu) return;

    // Direct toggle implementation
    const toggleMenu = () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      const newState = !isExpanded;
      
      toggleBtn.setAttribute('aria-expanded', newState.toString());
      navMenu.classList.toggle('is-open', newState);
      
      // Prevent body scroll on mobile overlay
      if (window.innerWidth < 768) {
        document.body.style.overflow = newState ? 'hidden' : '';
      }
    };

    const closeMenu = () => {
      toggleBtn.setAttribute('aria-expanded', 'false');
      navMenu.classList.remove('is-open');
      document.body.style.overflow = '';
    };

    // Remove existing event listeners by replacing with fresh clone on init
    const freshToggleBtn = toggleBtn.cloneNode(true) as HTMLElement;
    toggleBtn.parentNode?.replaceChild(freshToggleBtn, toggleBtn);

    freshToggleBtn.addEventListener('click', toggleMenu);

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });

    // Close menu when clicking nav links
    const links = navMenu.querySelectorAll('.nav-item');
    links.forEach(link => {
      link.addEventListener('click', closeMenu);
    });
  }

  // Dual initialization: covers initial page load and View Transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavigation);
  } else {
    initNavigation();
  }

  document.addEventListener('astro:page-load', initNavigation);
</script>

<style>
  .navbar {
    background-color: #1a1a1a;
    color: #ffffff;
    width: 100%;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    position: relative;
  }

  .logo {
    font-size: 1.25rem;
    font-weight: 500;
    color: #fff;
    text-decoration: none;
    z-index: 101;
  }

  /* Hamburger Icon Base */
  #menu-toggle {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 101;
  }

  .hamburger, 
  .hamburger::before, 
  .hamburger::after {
    display: block;
    width: 22px;
    height: 2px;
    background-color: #fff;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), 
                background-color 0.25s cubic-bezier(0.4, 0, 0.2, 1), 
                top 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hamburger {
    position: relative;
  }

  .hamburger::before, 
  .hamburger::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .hamburger::before { top: -7px; }
  .hamburger::after { top: 7px; }

  /* Morph to 'X' animation */
  #menu-toggle[aria-expanded="true"] .hamburger {
    background-color: transparent;
  }

  #menu-toggle[aria-expanded="true"] .hamburger::before {
    top: 0;
    transform: rotate(45deg);
  }

  #menu-toggle[aria-expanded="true"] .hamburger::after {
    top: 0;
    transform: rotate(-45deg);
  }

  /* Mobile Nav Drawer Overlay */
  @media (max-width: 767px) {
    .nav-links {
      display: flex;
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background-color: #1a1a1a;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.3s ease, visibility 0.3s ease;
      z-index: 100;
    }

    .nav-links.is-open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .nav-links ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2rem;
    }

    .nav-links a {
      color: #fff;
      text-decoration: none;
      font-size: 1.5rem;
      transition: opacity 0.2s ease;
    }

    .nav-links a:hover {
      opacity: 0.7;
    }
  }

  /* Desktop Navigation Layout */
  @media (min-width: 768px) {
    #menu-toggle {
      display: none;
    }

    .nav-links {
      display: flex !important;
      position: static;
      width: auto;
      height: auto;
      background: transparent;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .nav-links ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: row;
      gap: 0.5rem;
    }

    .nav-links a {
      color: #fff;
      text-decoration: none;
      font-size: 0.9375rem;
      padding: 0.5rem 0.875rem;
      display: block;
      transition: opacity 0.2s ease;
    }

    .nav-links a:hover {
      opacity: 0.7;
    }
  }
</style>