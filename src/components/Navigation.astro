---
const navItems = [
  { name: "Paintings", href: "/paintings" },
  { name: "Drawings", href: "/drawings" },
  { name: "Manga", href: "/manga" },
  { name: "About", href: "/about" },
  { name: "Contact", href: "/contact" },
];
---

<header class="navbar">
  <div class="nav-container">
    <a href="/" class="logo">Harikrishnan Varma</a>

    <!-- Hamburger Toggle Button -->
    <button 
      id="menu-toggle" 
      aria-label="Toggle Navigation" 
      aria-controls="nav-menu"
      aria-expanded="false"
    >
      <span class="hamburger"></span>
    </button>

    <!-- Navigation Links -->
    <nav id="nav-menu" class="nav-links">
      <ul>
        {navItems.map((item) => (
          <li><a href={item.href} class="nav-item">{item.name}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  function setupNav() {
    const toggleBtn = document.getElementById('menu-toggle');
    const navMenu = document.getElementById('nav-menu');

    if (!toggleBtn || !navMenu) return;

    // Clean toggle handler
    const toggleMenu = () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      navMenu.classList.toggle('is-open');
    };

    const closeMenu = () => {
      toggleBtn.setAttribute('aria-expanded', 'false');
      navMenu.classList.remove('is-open');
    };

    // Replace element to purge previous listeners on View Transitions
    const newToggleBtn = toggleBtn.cloneNode(true);
    toggleBtn.parentNode?.replaceChild(newToggleBtn, toggleBtn);

    newToggleBtn.addEventListener('click', toggleMenu);

    // Close on Escape key press
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });

    // Close when clicking any nav link
    const links = navMenu.querySelectorAll('.nav-item');
    links.forEach(link => link.addEventListener('click', closeMenu));
  }

  // astro:page-load handles both initial load and View Transitions automatically
  document.addEventListener('astro:page-load', setupNav);
</script>

<style>
  .navbar {
    background-color: #1a1a1a;
    color: #ffffff;
    width: 100%;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
  }

  .logo {
    font-size: 1.25rem;
    font-weight: 500;
    color: #fff;
    text-decoration: none;
  }

  /* Mobile menu default (hidden) */
  .nav-links {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background-color: #1a1a1a;
    border-bottom: 1px solid #2a2a2a;
  }

  .nav-links.is-open {
    display: block;
  }

  .nav-links ul {
    list-style: none;
    margin: 0;
    padding: 1rem 0;
    display: flex;
    flex-direction: column;
  }

  .nav-links a {
    color: #fff;
    text-decoration: none;
    padding: 0.75rem 1.5rem;
    display: block;
    transition: opacity 0.2s;
  }

  .nav-links a:hover {
    opacity: 0.7;
  }

  /* Hamburger Icon Styling */
  #menu-toggle {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hamburger, 
  .hamburger::before, 
  .hamburger::after {
    display: block;
    width: 22px;
    height: 2px;
    background-color: #fff;
    transition: transform 0.2s ease, background-color 0.2s ease, top 0.2s ease;
  }

  .hamburger {
    position: relative;
  }

  .hamburger::before, 
  .hamburger::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .hamburger::before { top: -6px; }
  .hamburger::after { top: 6px; }

  /* Morph to 'X' when menu is expanded */
  #menu-toggle[aria-expanded="true"] .hamburger {
    background-color: transparent;
  }

  #menu-toggle[aria-expanded="true"] .hamburger::before {
    top: 0;
    transform: rotate(45deg);
  }

  #menu-toggle[aria-expanded="true"] .hamburger::after {
    top: 0;
    transform: rotate(-45deg);
  }

  /* Desktop View Breakpoint */
  @media (min-width: 768px) {
    #menu-toggle {
      display: none;
    }

    .nav-links {
      display: flex !important;
      position: static;
      width: auto;
      background: transparent;
      border-bottom: none;
    }

    .nav-links ul {
      flex-direction: row;
      padding: 0;
    }

    .nav-links a {
      padding: 0 1rem;
    }
  }
</style>