---
interface NavItem {
  name: string;
  href: string;
  children?: { name: string; href: string }[];
}

const navItems: NavItem[] = [
  { name: "Paintings", href: "/paintings" },
  { name: "Drawings", href: "/drawings" },
  { 
    name: "Manga", 
    href: "/manga",
    children: [
      { name: "Tear Jerk", href: "/manga/tear-jerk" },      
    ]
  },
  { name: "About", href: "/about" },
  { name: "Contact", href: "/contact" },
];
---

<header class="navbar">
  <div class="nav-container">
    <a href="/" class="logo">Harikrishnan Varma</a>

    <!-- Hamburger Toggle Button -->
    <button 
      id="menu-toggle" 
      aria-label="Toggle Navigation" 
      aria-controls="nav-menu"
      aria-expanded="false"
      type="button"
    >
      <span class="hamburger"></span>
    </button>

    <!-- Navigation Links -->
    <nav id="nav-menu" class="nav-links">
      <ul>
        {navItems.map((item) => (
          <li class={item.children ? "has-dropdown" : ""}>
            {item.children ? (
              <>
                <div class="dropdown-header">
                  <a href={item.href} class="nav-item main-link">{item.name}</a>
                  <button 
                    class="dropdown-toggle" 
                    aria-label={`Toggle ${item.name} submenu`}
                    aria-expanded="false"
                    type="button"
                  >
                    <svg class="chevron" width="12" height="8" viewBox="0 0 10 6" fill="none">
                      <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>
                <ul class="dropdown-menu">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} class="nav-item dropdown-item">{child.name}</a>
                    </li>
                  ))}
                </ul>
              </>
            ) : (
              <a href={item.href} class="nav-item">{item.name}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  function initNavigation() {
    const toggleBtn = document.getElementById('menu-toggle');
    const navMenu = document.getElementById('nav-menu');

    if (!toggleBtn || !navMenu) return;

    // Reset drawer state on init
    const closeMenu = () => {
      toggleBtn.setAttribute('aria-expanded', 'false');
      navMenu.classList.remove('is-open');
      document.body.style.overflow = '';

      navMenu.querySelectorAll('.dropdown-toggle').forEach(btn => btn.setAttribute('aria-expanded', 'false'));
      navMenu.querySelectorAll('.dropdown-menu').forEach(menu => menu.classList.remove('is-open'));
    };

    // Clean event handlers using AbortController for View Transitions
    const controller = new AbortController();
    const { signal } = controller;

    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      const newState = !isExpanded;
      
      toggleBtn.setAttribute('aria-expanded', newState.toString());
      navMenu.classList.toggle('is-open', newState);
      
      if (window.innerWidth < 768) {
        document.body.style.overflow = newState ? 'hidden' : '';
      }
    }, { signal });

    // Mobile Accordion Toggles
    const dropdownHeaders = navMenu.querySelectorAll('.dropdown-header');
    dropdownHeaders.forEach(header => {
      header.addEventListener('click', (e) => {
        // Only run accordion logic on mobile screens
        if (window.innerWidth >= 768) return;

        const btn = header.querySelector('.dropdown-toggle');
        const parentLi = header.closest('li');
        const subMenu = parentLi?.querySelector('.dropdown-menu');
        
        // Toggle accordion when tapping row or button
        if (btn && subMenu) {
          const isExpanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', (!isExpanded).toString());
          subMenu.classList.toggle('is-open', !isExpanded);
        }
      }, { signal });
    });

    // Close menu on ESC
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    }, { signal });

    // Close drawer when clicking links
    const links = navMenu.querySelectorAll('.nav-item');
    links.forEach(link => {
      link.addEventListener('click', closeMenu, { signal });
    });

    // Cleanup listeners prior to next View Transition swap
    document.addEventListener('astro:before-swap', () => {
      controller.abort();
      document.body.style.overflow = '';
    }, { once: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavigation);
  } else {
    initNavigation();
  }

  document.addEventListener('astro:page-load', initNavigation);
</script>

<style>
  .navbar {
    background-color: #1a1a1a;
    color: #ffffff;
    width: 100%;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    position: relative;
  }

  .logo {
    font-size: 1.25rem;
    font-weight: 500;
    color: #fff;
    text-decoration: none;
    z-index: 101;
  }

  /* Hamburger Button */
  #menu-toggle {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 101;
  }

  .hamburger, 
  .hamburger::before, 
  .hamburger::after {
    display: block;
    width: 22px;
    height: 2px;
    background-color: #fff;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), 
                background-color 0.25s cubic-bezier(0.4, 0, 0.2, 1), 
                top 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hamburger { position: relative; }
  .hamburger::before, .hamburger::after { content: ''; position: absolute; left: 0; }
  .hamburger::before { top: -7px; }
  .hamburger::after { top: 7px; }

  #menu-toggle[aria-expanded="true"] .hamburger { background-color: transparent; }
  #menu-toggle[aria-expanded="true"] .hamburger::before { top: 0; transform: rotate(45deg); }
  #menu-toggle[aria-expanded="true"] .hamburger::after { top: 0; transform: rotate(-45deg); }

  /* Mobile Navigation Drawer */
  @media (max-width: 767px) {
    .nav-links {
      display: flex;
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100dvh; /* Dynamic Viewport Height for mobile browsers */
      background-color: #1a1a1a;
      flex-direction: column;
      padding: 6rem 2rem 3rem 2rem;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.25s ease, visibility 0.25s ease;
      z-index: 100;
      overflow-y: auto; /* Handles vertical scrolling if accordion overflows screen */
    }

    .nav-links.is-open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .nav-links ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      width: 100%;
      gap: 0.5rem;
    }

    .dropdown-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      cursor: pointer;
    }

    .nav-links a {
      color: #fff;
      text-decoration: none;
      font-size: 1.4rem;
      padding: 0.75rem 0;
      display: block;
      width: 100%;
    }

    .dropdown-toggle {
      background: transparent;
      border: none;
      color: #fff;
      padding: 0.75rem;
      cursor: pointer;
      display: flex;
      align-items: center;
    }

    .chevron {
      transition: transform 0.25s ease;
    }

    .dropdown-toggle[aria-expanded="true"] .chevron {
      transform: rotate(180deg);
    }

    .dropdown-menu {
      list-style: none;
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transition: max-height 0.3s cubic-bezier(0, 1, 0, 1), opacity 0.25s ease;
      padding-left: 1rem;
      border-left: 2px solid #333;
      margin: 0;
    }

    .dropdown-menu.is-open {
      max-height: 300px;
      opacity: 1;
      transition: max-height 0.3s cubic-bezier(1, 0, 1, 0), opacity 0.25s ease;
    }

    .dropdown-menu a {
      font-size: 1.15rem;
      color: #b3b3b3;
      padding: 0.5rem 0;
    }
  }

  /* Desktop Styles */
  @media (min-width: 768px) {
    #menu-toggle { display: none; }

    .nav-links {
      display: flex !important;
      position: static;
      width: auto;
      height: auto;
      background: transparent;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .nav-links ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 0.5rem;
    }

    .nav-links li {
      position: relative;
    }

    .dropdown-header {
      display: flex;
      align-items: center;
    }

    .nav-links a {
      color: #fff;
      text-decoration: none;
      font-size: 0.9375rem;
      padding: 0.5rem 0.875rem;
      display: block;
      transition: opacity 0.2s ease;
    }

    .nav-links a:hover {
      opacity: 0.7;
    }

    .dropdown-toggle {
      background: transparent;
      border: none;
      color: #fff;
      padding: 0.5rem 0.5rem 0.5rem 0;
      cursor: pointer;
      display: flex;
      align-items: center;
      margin-left: -0.375rem;
    }

    .dropdown-menu {
      position: absolute;
      top: 100%;
      left: 0;
      background-color: #242424;
      border-radius: 6px;
      min-width: 190px;
      padding: 0.5rem 0;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
      opacity: 0;
      visibility: hidden;
      transform: translateY(8px);
      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
      display: flex !important;
      flex-direction: column !important;
      gap: 0 !important;
    }

    /* Invisible hover bridge prevents cursor gap dropouts */
    .dropdown-menu::before {
      content: '';
      position: absolute;
      top: -10px;
      left: 0;
      width: 100%;
      height: 10px;
    }

    .has-dropdown:hover .dropdown-menu,
    .has-dropdown:focus-within .dropdown-menu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .has-dropdown:hover .chevron {
      transform: rotate(180deg);
    }

    .dropdown-menu a {
      padding: 0.6rem 1rem;
      font-size: 0.875rem;
      color: #e5e5e5;
    }

    .dropdown-menu a:hover {
      background-color: #333333;
      opacity: 1;
    }
  }
</style>