---
// src/pages/404.astro
import PortfolioLayout from '../../layouts/Layout.astro';

import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export async function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'ml' } },
  ];
}
---

<PortfolioLayout title="404: Page Not Found — Harikrishnan Varma">
  <main class="error-container">
    <div class="error-content">
      <span class="error-code">404</span>
      <h1>Page Not Found</h1>
      <p>The painting or page you are looking for doesn't exist or has been moved.</p>
      
      <div class="action-links">
        <a href="/" class="btn-primary">Return Home</a>
        <a href="/paintings" class="btn-secondary">View All Paintings</a>
      </div>
    </div>
  </main>
</PortfolioLayout>

<style>
  .error-container {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem 1rem;
  }

  .error-code {
    display: block;
    font-size: 5rem;
    font-weight: 300;
    color: var(--muted-color, #999);
    line-height: 1;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: 400;
    margin-bottom: 1rem;
  }

  p {
    color: var(--muted-color, #666);
    max-width: 400px;
    margin: 0 auto 2rem auto;
    line-height: 1.6;
  }

  .action-links {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  .btn-primary, .btn-secondary {
    padding: 0.75rem 1.25rem;
    font-size: 0.9rem;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background-color: var(--text-color, #111);
    color: #fff;
  }

  .btn-primary:hover {
    opacity: 0.85;
  }

  .btn-secondary {
    border: 1px solid var(--border-color, #ccc);
    color: inherit;
  }

  .btn-secondary:hover {
    background-color: #f5f5f5;
  }
</style>