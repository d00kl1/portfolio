---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

export async function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'ml' } },
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('nav.about') || 'About'}>
  <main class="about-container">
    <h1>{t('nav.about') || 'About'}</h1>
    <p class="intro">{t('about.intro')}</p>    
  </main>
</Layout>

<style>
  .about-container {
    max-width: 600px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  h1 {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .intro {
    font-size: 1.1rem;
    color: #a3a3a3;
    margin-bottom: 2rem;
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.1rem;
  }

  .label {
    font-weight: 600;
    color: #e5e5e5;
    min-width: 90px;
  }

  .contact-list a {
    color: #ff0000;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .contact-list a:hover {
    opacity: 0.75;
    text-decoration: underline;
  }
</style>