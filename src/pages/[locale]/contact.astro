---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

export async function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'ml' } },
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('nav.contact') || 'Contact'}>
  <main class="contact-container">
    <h1>{t('nav.contact') || 'Contact'}</h1>
    <p class="intro">{t('contact.intro') || 'A few ways to reach out:'}</p>

    <ul class="contact-list">
      <li>
        <span class="label">Mail:</span>
        <a href="mailto:hari@harikrishnanvarma.com">Harikrishnan Varma</a>
      </li>
      <li>
        <span class="label">Instagram:</span>
        <a 
          href="https://instagram.com/d00kl1" 
          target="_blank" 
          rel="noopener noreferrer"
        >
          @d00kl1
        </a>
      </li>
    </ul>
  </main>
</Layout>

<style>
  .contact-container {
    max-width: 600px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  h1 {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .intro {
    font-size: 1.1rem;
    color: #a3a3a3;
    margin-bottom: 2rem;
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.1rem;
  }

  .label {
    font-weight: 600;
    color: #e5e5e5;
    min-width: 90px;
  }

  .contact-list a {
    color: #ff0000;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .contact-list a:hover {
    opacity: 0.75;
    text-decoration: underline;
  }
</style>