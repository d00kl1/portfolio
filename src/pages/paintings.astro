---
/* src/pages/paintings.astro */
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import PortfolioLayout from '../layouts/Layout.astro';
import Lightbox from '../components/Lightbox.astro';

const paintings = await getCollection('paintings');
const sortedPaintings = paintings.sort((a, b) => b.data.year - a.data.year);

const galleryItems = await Promise.all(
  sortedPaintings.map(async (item) => {
    const fullImage = await getImage({
      src: item.data.coverImage,
      format: 'webp',
      width: 2800,
      quality: 90,
    });

    // Format robust URL for production static preview builds
    const resolvedUrl = fullImage.src.startsWith('http') 
      ? fullImage.src 
      : fullImage.src.startsWith('/') 
        ? fullImage.src 
        : `/${fullImage.src}`;

    return {
      ...item,
      lightboxUrl: resolvedUrl,
    };
  })
);
---

<PortfolioLayout title="Paintings — Harikrishnan Varma">
  <main class="gallery-container">
    <header class="gallery-header">
      <h1>Paintings</h1>
    </header>

    <div class="gallery-grid">
      {galleryItems.map((item) => (
        <article class="art-card">
          <div 
            class="image-frame" 
            data-lightbox-src={item.lightboxUrl} 
            data-lightbox-alt={item.data.alt}
            data-lightbox-title={item.data.title}
            data-lightbox-meta={`${item.data.medium} • ${item.data.year}`}
            tabindex="0"
            role="button"
            aria-label={`Enlarge and inspect ${item.data.title}`}
          >
            <Image 
              src={item.data.coverImage} 
              alt={item.data.alt} 
              width={800} 
              format="webp"
              quality={82} 
            />
          </div>

          <div class="art-details">
            <a href={`/paintings/${item.id}`}>
              <h2>{item.data.title}</h2>
            </a>
            <p class="meta">{item.data.medium} • {item.data.year}</p>
          </div>
        </article>
      ))}
    </div>
  </main>

  <Lightbox />
</PortfolioLayout>

<style>
  .gallery-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .gallery-header {
    margin-bottom: 2.5rem;
  }

  .gallery-header h1 {
    font-size: 2rem;
    font-weight: 400;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 2.5rem 2rem;
  }

  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .art-card {
    display: flex;
    flex-direction: column;
  }

  .image-frame {
    position: relative;
    cursor: pointer;
    overflow: hidden;
    background-color: #121212;
    border-radius: 2px;
    outline: none;
  }

  .image-frame:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 4px;
  }

  .image-frame img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .image-frame:hover img {
    transform: scale(1.03);
  }

  .art-details {
    margin-top: 0.875rem;
  }

  .art-details a {
    text-decoration: none;
    color: #ffffff;
  }

  .art-details h2 {
    font-size: 1rem;
    font-weight: 400;
    margin: 0 0 0.25rem 0;
    transition: color 0.2s ease;
  }

  .art-details a:hover h2 {
    color: #a0a0a0;
  }

  .art-details .meta {
    font-size: 0.8125rem;
    color: #888888;
    margin: 0;
  }
</style>