---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import PortfolioLayout from '../layouts/Layout.astro';
import Lightbox from '../components/Lightbox.astro';

const paintings = await getCollection('paintings');
const sortedPaintings = paintings.sort((a, b) => b.data.year - a.data.year);

// Generate web-accessible URL paths for high-resolution lightbox view
const galleryItems = await Promise.all(
  sortedPaintings.map(async (item) => {
    const fullImage = await getImage({
      src: item.data.coverImage,
      format: 'webp',
      width: 1800,
      quality: 85,
    });
    return {
      ...item,
      lightboxUrl: fullImage.src,
    };
  })
);
---

<PortfolioLayout title="Paintings — Harikrishnan Varma">
  <main class="gallery-container">
    <header class="gallery-header">
      <h1>Paintings</h1>
    </header>

    <div class="gallery-grid">
      {galleryItems.map((item) => (
        <article class="art-card">
          <div 
            class="image-frame" 
            data-lightbox-src={item.lightboxUrl} 
            data-lightbox-alt={item.data.alt}
            data-lightbox-title={item.data.title}
            data-lightbox-meta={`${item.data.medium} • ${item.data.year}`}
            tabindex="0"
            role="button"
            aria-label={`Enlarge ${item.data.title}`}
          >
            <Image 
              src={item.data.coverImage} 
              alt={item.data.alt} 
              width={800} 
              format="webp"
              quality={80} 
            />
            <span class="zoom-indicator" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
            </span>
          </div>

          <div class="art-details">
            <a href={`/paintings/${item.id}`}>
              <h2>{item.data.title}</h2>
            </a>
            <p class="meta">{item.data.medium} • {item.data.year}</p>
          </div>
        </article>
      ))}
    </div>
  </main>

  <Lightbox />
</PortfolioLayout>

<style>
  .gallery-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .gallery-header {
    margin-bottom: 2.5rem;
  }

  .gallery-header h1 {
    font-size: 2rem;
    font-weight: 400;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 2.5rem 2rem;
  }

  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .art-card {
    display: flex;
    flex-direction: column;
  }

  .image-frame {
    position: relative;
    cursor: zoom-in;
    overflow: hidden;
    background-color: #121212;
    border-radius: 2px;
    outline: none;
  }

  .image-frame:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 4px;
  }

  .image-frame img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .image-frame:hover img {
    transform: scale(1.03);
  }

  .zoom-indicator {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    background: rgba(18, 18, 18, 0.85);
    color: #ffffff;
    padding: 0.5rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: none;
  }

  .image-frame:hover .zoom-indicator {
    opacity: 1;
    transform: scale(1.05);
  }

  .art-details {
    margin-top: 0.875rem;
  }

  .art-details a {
    text-decoration: none;
    color: #ffffff;
  }

  .art-details h2 {
    font-size: 1rem;
    font-weight: 400;
    margin: 0 0 0.25rem 0;
    transition: color 0.2s ease;
  }

  .art-details a:hover h2 {
    color: #a0a0a0;
  }

  .art-details .meta {
    font-size: 0.8125rem;
    color: #888888;
    margin: 0;
  }
</style>